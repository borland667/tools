#!/usr/bin/env bash
# Re-runnable machine setup. Prints one line per item and exits non-zero until
# nothing is missing. Pass --check to report without installing anything.
# Never prints a secret. Replace each {{FIELD}} and delete checks that do not
# apply.
set -u

mode=install
[ "${1:-}" = "--check" ] && mode=check

missing=()
ok()   { printf '  \342\234\223 %s\n' "$1"; }
miss() { printf '  \342\234\227 %s\n' "$1"; missing+=("$1"); }

cd "$(git rev-parse --show-toplevel)" || exit 1

# Version manager installed and active in this shell.
if command -v {{VERSION_MANAGER}} >/dev/null 2>&1; then
  ok "{{VERSION_MANAGER}} installed"
else
  miss "{{VERSION_MANAGER}}: install with {{INSTALL_COMMAND}}, then open a new terminal"
fi

# Pinned tools: with --check they are only tested for presence.
if [ "$mode" = check ]; then
  if {{TOOL_PRESENCE_CHECK}} >/dev/null 2>&1; then
    ok "pinned tools present"
  else
    miss "pinned tools: run '{{VERSION_MANAGER}} install'"
  fi
else
  if {{VERSION_MANAGER}} install >/dev/null 2>&1; then
    ok "pinned tools installed"
  else
    miss "pinned tools: run '{{VERSION_MANAGER}} install' and read its error"
  fi
fi

# Dependencies.
if [ "$mode" = check ]; then
  if {{DEPENDENCY_PRESENCE_CHECK}} >/dev/null 2>&1; then
    ok "dependencies present"
  else
    miss "dependencies: run '{{INSTALL_DEPENDENCIES}}'"
  fi
else
  if {{INSTALL_DEPENDENCIES}} >/dev/null 2>&1; then
    ok "dependencies installed"
  else
    miss "dependencies: run '{{INSTALL_DEPENDENCIES}}' and read its error"
  fi
fi

# Container runtime, if the local stack needs one.
if docker info >/dev/null 2>&1; then
  ok "container runtime running"
else
  miss "container runtime: start it, then re-run this script"
fi

# Secret key present and able to decrypt, tested without printing a value.
key_file="{{PRIVATE_KEY_PATH}}"
if [ -r "$key_file" ] && {{DECRYPT_ONE_HARMLESS_VALUE}} >/dev/null 2>&1; then
  ok "secret key decrypts the secrets file"
else
  miss "secret key: get it from {{PASSWORD_MANAGER_ITEM}} and save it to $key_file (mode 600)"
fi

if [ "${#missing[@]}" -eq 0 ]; then
  printf '\nReady. Next: open a new terminal, then run {{DEV_COMMAND}}.\n'
  exit 0
fi
printf '\n%d item(s) missing. Fix them and run this script again.\n' "${#missing[@]}"
exit 1
