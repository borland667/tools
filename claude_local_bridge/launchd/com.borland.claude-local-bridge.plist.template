<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.borland.claude-local-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__</string>
    <string>__BRIDGE_DIR__/bridge.mjs</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CLAUDE_LOCAL_PROVIDERS_FILE</key>
    <string>__BRIDGE_DIR__/providers.local.json</string>
    <key>OMLX_API_KEY</key>
    <string>local-bridge</string>
    <key>LMSTUDIO_API_KEY</key>
    <string>local-bridge</string>
    <key>CLAUDE_LOCAL_BRIDGE_HOST</key>
    <string>127.0.0.1</string>
    <key>CLAUDE_LOCAL_BRIDGE_PORT</key>
    <string>1245</string>
    <key>CLAUDE_LOCAL_MODEL_SYNC_INTERVAL_MS</key>
    <string>30000</string>
    <key>CLAUDE_LOCAL_MAIN_MODEL</key>
    <string>omlx/Qwen3.5-9b-Sushi-Coder-RL-MLX</string>
    <key>CLAUDE_LOCAL_SMALL_MODEL</key>
    <string>omlx/Qwen3.5-9b-Sushi-Coder-RL-MLX</string>
    <key>CLAUDE_LOCAL_TOOL_MODEL</key>
    <string>omlx/Qwen3.5-9b-Sushi-Coder-RL-MLX</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>__BRIDGE_DIR__</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/claude-local-bridge.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/claude-local-bridge.log</string>
</dict>
</plist>
