# Upstream oMLX API
OMLX_BASE_URL=http://127.0.0.1:8005/v1
OMLX_API_KEY=sk-local

# Router listener
ROUTER_HOST=127.0.0.1
ROUTER_PORT=8010
ROUTER_RELOAD=false
LOG_LEVEL=INFO

# Auto model aliases
AUTO_MODEL=auto
AUTO_CHAT_MODEL=auto-chat
AUTO_AGENT_MODEL=auto-agent

# Classifier
CLASSIFIER_MODEL=gemma-4-e4b-it-4bit
CLASSIFIER_TIMEOUT=10
CLASSIFIER_THRESHOLD=0.65
CLASSIFIER_MAX_CHARS=12000
CLASSIFIER_CACHE_TTL=300
ALLOW_HEAVY_MODELS=true

# Routed models
MODEL_CODER=Qwen3.5-9b-Sushi-Coder-RL-MLX
MODEL_EMBEDDING=Qwen3-Embedding-0.6B-4bit-DWQ
MODEL_RERANKER=Qwen3-Reranker-0.6B-4bit
MODEL_REASONER=Qwen3-Next-80B-A3B-Thinking-4bit
MODEL_THINKING=Qwen3-Next-80B-A3B-Thinking-4bit
MODEL_REVIEW=Qwen3.6-35B-A3B-Claude-Opus-VL-grafted-MLX-8bit
MODEL_FAST=gemma-4-e4b-it-4bit
MODEL_VISION=Qwen3-VL-4B-Instruct-4bit
MODEL_VISUAL_QUALITY=VisualQuality-R1-7B-4bit
